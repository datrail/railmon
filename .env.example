# RailMon does not load this file automatically. Export selected values when
# running from source, or pass it explicitly with `docker run --env-file`.
# Every value is blank on purpose: copy only the settings your deployment owns.

# Runtime collector ---------------------------------------------------------
# Probe path. SSLSNIFF_PATH is the legacy fallback after AGENTSIGHT_PATH.
AGENTSIGHT_PATH=
SSLSNIFF_PATH=

# env_logger filter, for example `railmon=debug`.
RUST_LOG=

# Scanner and forwarder -----------------------------------------------------
# Rail Center base URL. Used by `scan --register` and `forward`.
RAIL_CENTER_URL=

# Host identity shared with RailProxy. RailScan deliberately invents no
# fallback when this is unset.
RAIL_HOST_ID=

# Registration authentication: none, bearer, or gcp. Bearer mode requires the
# token; gcp is reserved for the shared token client and currently fails loud.
RAIL_AUTH_MODE=
RAIL_AUTH_TOKEN=

# Optional scanner output locations.
RAIL_FEATURE_OUTPUT=
RAIL_REGISTRATION_OUTPUT=

# Optional scanner overrides and skill search roots.
RAIL_OWNER=
RAIL_LLM_PROVIDER=
RAIL_LLM_MODEL=
RAIL_SCAN_SKILL_ROOTS=

# Scanner observation inputs -----------------------------------------------
# These describe the agent being scanned. Do not inject provider credentials
# into RailMon merely to populate them; the scanner observes values already in
# its subject environment and redacts secrets from every persisted artifact.
RAIL_SANDBOX_TYPE=
RAIL_LLM_BASE_URL=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
MODEL=
SANDBOX_TYPE=
OPENAI_BASE_URL=
OPENAI_API_BASE=
OPENAI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_HOST=
OPENCLAW_HOME=
OPENCLAW_MODEL=
NEMOCLAW_HOME=

# Development and packaging -------------------------------------------------
# Override only when running the checkout helpers against a non-sibling repo.
RAIL_AGENT_HARDENING_ROOT=
SKILL_SCANNER_STARTUP_DELAY=

# `make fetch-agentsight` download source.
AGENTSIGHT_URL=

# Container entrypoint internals. Image defaults normally own these.
RAILMON_ROOT=
RAILMON_BIN=
