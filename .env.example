# RailMon does not load this file automatically. Copy selected settings into
# the ignored `.env`, then export them for a source run or pass that file with
# `docker run --env-file .env`. Every value here is blank on purpose.

# Runtime collector ---------------------------------------------------------
# Probe path. SSLSNIFF_PATH is the legacy fallback after AGENTSIGHT_PATH.
AGENTSIGHT_PATH=
SSLSNIFF_PATH=

# env_logger filter, for example `railmon=debug`.
RUST_LOG=

# Scanner and forwarder -----------------------------------------------------
# Rail Center base URL. Used by `scan --register` (which sends it the evidence
# bundle at /v1/agents/register) and `forward`.
RAIL_CENTER_URL=

# Host identity shared with RailProxy and every other Rail component on the
# host (`scan`, also `--host-id`). It names the host in the evidence bundle
# and the registration. The scanner reads its own value first, then (in
# --mode docker) the scanned container's, and invents no fallback: with none
# found, the evidence bundle fails its contract and the scan exits 2 (pass
# --no-evidence-bundle, and set no RailDash URL or --register, to scan without
# one).
RAIL_HOST_ID=

# Credential for Rail Center: none (default), bearer, or gcp. The collector's
# --webhook and `forward` implement all three: bearer takes RAIL_AUTH_TOKEN or
# RAIL_AUTH_TOKEN_FILE (re-read on every flush, so rotation needs no restart;
# not both), gcp mints an identity token for RAIL_AUTH_AUDIENCE from the metadata
# server (GCE_METADATA_HOST overrides its address). `scan --register` reads
# them the same way.
RAIL_AUTH_MODE=
RAIL_AUTH_TOKEN=
RAIL_AUTH_TOKEN_FILE=
RAIL_AUTH_AUDIENCE=
GCE_METADATA_HOST=

# Optional scanner output locations (`scan`; the same as --feature-output,
# --registration-output and --evidence-bundle-output).
RAIL_FEATURE_OUTPUT=
RAIL_REGISTRATION_OUTPUT=
RAIL_EVIDENCE_BUNDLE_OUTPUT=

# RailDash evidence-bundle delivery (DR-121/DR-83). Naming a URL is itself the
# request to deliver. RAIL_RAILDASH_TOKEN is RailDash's local write token
# (`X-RailDash-Token`): the RAILDASH_TOKEN RailDash was started with, or else
# the contents of the `<db path>.token` file it persists. It stays the same
# across RailDash restarts and is never printed -- except with an in-memory
# database (`:memory:`), which has no token file and gets a new random token
# on every start unless RAILDASH_TOKEN is set. Required by RailDash's
# write-route guard (DR-120), even on loopback. RAIL_AGENT_KEY names the agent for RailDash when the bundle
# carries no deployment pair (--agent-key); `scan --register` sends it to Rail
# Center as ?agent_key= with a v1 bundle. RAIL_SCAN_INTERVAL_IN_SECONDS keeps
# the scanner running instead of scan-once-and-exit; an unchanged bundle is
# re-sent as the same bytes, so RailDash keeps one ASP for it. It is left
# commented out: set, even to an empty value, it turns interval mode on
# (every 3600 seconds when the value is not a number).
RAIL_RAILDASH_URL=
RAIL_RAILDASH_TOKEN=
RAIL_AGENT_KEY=
# RAIL_SCAN_INTERVAL_IN_SECONDS=

# Optional scanner overrides and skill search roots.
RAIL_OWNER=
RAIL_LLM_PROVIDER=
RAIL_LLM_MODEL=
RAIL_SCAN_SKILL_ROOTS=

# Optional `scan` inputs, the same as the flag named beside each: an AgentSight
# snapshot (--observed-file), listensnoop's JSON lines (--listen-file),
# filesnoop's JSON lines (--files-file), and the multi-agent target manifest
# (--target-manifest).
RAIL_OBSERVED_FILE=
RAIL_LISTEN_FILE=
RAIL_FILES_FILE=
RAIL_TARGET_MANIFEST=

# `collect` -----------------------------------------------------------------
# RAIL_COLLECT_CONTAINER makes `collect` follow that container's TLS library
# and session across restarts (README "Following a container"). RAIL_DOCKER
# below applies to it too. RAIL_COLLECTOR is the collector the supervisor
# runs when started without the entrypoint, which always passes --collector.
RAIL_COLLECT_CONTAINER=

# `listen` ------------------------------------------------------------------
# RAIL_LISTEN_FILE above is also where `listen` appends (stdout when unset).
# RAIL_LISTEN_CONTAINER makes it follow that container's PID namespace across
# agent restarts; RAIL_LISTEN_HEARTBEAT is the probe's heartbeat in seconds
# (default 60). The rest override tool paths the image already sets.
RAIL_LISTEN_CONTAINER=
RAIL_LISTEN_HEARTBEAT=
LISTENSNOOP_PATH=
RAIL_DOCKER=
RAIL_NSENTER=

# `files` -------------------------------------------------------------------
# The same as `listen`, for filesnoop: RAIL_FILES_FILE above is where it
# appends (stdout when unset), RAIL_FILES_CONTAINER the container to follow,
# RAIL_FILES_HEARTBEAT the heartbeat in seconds (default 60). RAIL_DOCKER and
# RAIL_NSENTER above apply to it too.
RAIL_FILES_CONTAINER=
RAIL_FILES_HEARTBEAT=
FILESNOOP_PATH=

# Scanner observation inputs -----------------------------------------------
# These describe the agent being scanned. Do not inject provider credentials
# into RailMon merely to populate them; the scanner observes values already in
# its subject environment and redacts secrets from every persisted artifact.
# The scanner also reads USER, LOGNAME, HOME and GIT_AUTHOR_EMAIL as they
# already are; they are not settings and are left out here on purpose.
RAIL_SANDBOX_TYPE=
RAIL_LLM_BASE_URL=
RAIL_DEPLOYMENT=
RAIL_NAMESPACE=
AGENT_MCP_NAME=
AGENT_MCP_URL=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
MODEL=
SANDBOX_TYPE=
OPENAI_BASE_URL=
OPENAI_API_BASE=
OPENAI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_HOST=
OPENCLAW_HOME=
OPENCLAW_MODEL=
NEMOCLAW_HOME=

# Development and packaging -------------------------------------------------
# Deprecated: tools/skills/run-*.sh use the Compose files vendored under
# tools/skills/examples/. Set, they use $RAIL_AGENT_HARDENING_ROOT/<agent>
# instead and print a deprecation note.
RAIL_AGENT_HARDENING_ROOT=
SKILL_SCANNER_STARTUP_DELAY=

# `make fetch-agentsight` download source.
AGENTSIGHT_URL=

# Container entrypoint internals. Image defaults normally own these.
RAILMON_ROOT=
RAILMON_BIN=

# Local demo ----------------------------------------------------------------
# `railmon demo` only; nothing else reads these. All unset, the demo is
# file-only with a random session id — see tools/local-demo/README.md.
RAILMON_DEMO_OUT=
RAILMON_SESSION_ID=
RAILMON_WEBHOOK_URL=
