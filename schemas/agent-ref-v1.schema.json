{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datrail.io/schema/agent-ref-v1.schema.json",
  "title": "DatRail sandbox-local agent reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["host_id", "sandbox_name", "agent_key"],
  "properties": {
    "host_id": {"type": "string", "minLength": 1},
    "sandbox_name": {"type": "string", "minLength": 1},
    "agent_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "not": {"const": "default"}}
  }
}
