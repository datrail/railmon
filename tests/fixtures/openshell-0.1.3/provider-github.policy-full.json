{
  "active_version": 1,
  "config_revision": 10022551992314382855,
  "hash": "48a447ba2539941c695e54e31ae77734bb59259ed6924b436646458ee26826a8",
  "policy": {
    "filesystem_policy": {
      "include_workdir": true,
      "read_only": [
        "/bin",
        "/usr",
        "/lib",
        "/proc",
        "/dev/urandom",
        "/etc",
        "/var/log",
        "/opt"
      ],
      "read_write": [
        "/sandbox",
        "/tmp",
        "/dev/null"
      ]
    },
    "landlock": {
      "compatibility": "best_effort"
    },
    "network_policies": {
      "_provider_fx_github": {
        "binaries": [
          {
            "path": "/usr/bin/gh"
          },
          {
            "path": "/usr/local/bin/gh"
          },
          {
            "path": "/usr/bin/git"
          },
          {
            "path": "/usr/local/bin/git"
          }
        ],
        "endpoints": [
          {
            "access": "read-only",
            "enforcement": "enforce",
            "host": "api.github.com",
            "port": 443,
            "protocol": "rest"
          },
          {
            "access": "read-only",
            "enforcement": "enforce",
            "host": "api.github.com",
            "path": "/graphql",
            "port": 443,
            "protocol": "graphql"
          },
          {
            "enforcement": "enforce",
            "host": "github.com",
            "port": 443,
            "protocol": "rest",
            "rules": [
              {
                "allow": {
                  "method": "GET",
                  "path": "**"
                }
              },
              {
                "allow": {
                  "method": "HEAD",
                  "path": "**"
                }
              },
              {
                "allow": {
                  "method": "OPTIONS",
                  "path": "**"
                }
              },
              {
                "allow": {
                  "method": "POST",
                  "path": "/**/git-upload-pack"
                }
              }
            ]
          }
        ],
        "name": "_provider_fx_github"
      },
      "example_wildcard": {
        "binaries": [
          {
            "path": "/usr/local/bin/python3.13"
          }
        ],
        "endpoints": [
          {
            "access": "read-write",
            "enforcement": "audit",
            "host": "*.example.com",
            "ports": [
              443,
              8443
            ],
            "protocol": "rest"
          }
        ],
        "name": "example-wildcard"
      },
      "github_api": {
        "binaries": [
          {
            "path": "/usr/local/bin/python3.13"
          }
        ],
        "endpoints": [
          {
            "access": "read-only",
            "enforcement": "enforce",
            "host": "api.github.com",
            "port": 443,
            "protocol": "rest"
          }
        ],
        "name": "github-api-readonly"
      },
      "github_uploads": {
        "binaries": [
          {
            "path": "/usr/local/bin/python3.13"
          }
        ],
        "endpoints": [
          {
            "enforcement": "enforce",
            "host": "uploads.github.com",
            "port": 443,
            "protocol": "rest",
            "rules": [
              {
                "allow": {
                  "method": "GET",
                  "path": "/repos/**"
                }
              },
              {
                "allow": {
                  "method": "POST",
                  "path": "/repos/*/*/releases/*/assets"
                }
              }
            ]
          }
        ],
        "name": "github-uploads"
      },
      "raw_content": {
        "binaries": [
          {
            "path": "/usr/local/bin/python3.13"
          },
          {
            "path": "/usr/bin/curl"
          }
        ],
        "endpoints": [
          {
            "host": "raw.githubusercontent.com",
            "port": 443
          }
        ],
        "name": "raw-content"
      }
    },
    "version": 1
  },
  "policy_source": "sandbox",
  "sandbox": "fx-provider-gh",
  "scope": "sandbox",
  "status": "effective",
  "version": 1
}
